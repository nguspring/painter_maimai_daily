{
  "manifest_version": 2,
  "version": "4.0.0",
  "name": "画家麦麦的日常",
  "description": "基于 MaiBot 的多模型智能绘图插件，支持原生 NovelAI、OpenAI、Gemini、豆包、百炼、ComfyUI 等接口。提供内置日程与日程注入、空间/群/私聊多渠道自动自拍、群聊主动图片、聊天设置持久化、额度管理和对外生图 API，并可选对接 MaiTrace。",
  "plugin_type": "creative",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "image"
    }
  },
  "author": {
    "name": "Ptrel, Rabbit-Jia-Er, saberlights Kiuon, nguspring",
    "url": "https://github.com/nguspring/painter_maimai_daily"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/nguspring/painter_maimai_daily",
    "homepage": "https://github.com/nguspring/painter_maimai_daily",
    "issues": "https://github.com/nguspring/painter_maimai_daily/issues"
  },
  "host_application": {
    "min_version": "1.3.11",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {"type": "python_package", "name": "maibot-plugin-sdk", "version_spec": ">=2.15.0,<3"},
    {"type": "python_package", "name": "requests", "version_spec": ">=2.28.0"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=10"},
    {"type": "python_package", "name": "pydantic", "version_spec": ">=2,<3"},
    {"type": "python_package", "name": "tomlkit", "version_spec": ">=0.12"},
    {"type": "python_package", "name": "tzdata", "version_spec": ">=2024.1"},
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.24,<1"}
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.hybrid",
    "config.get",
    "llm.generate",
    "message.get_by_id",
    "message.get_recent",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.get_all_streams",
    "api.call",
    "api.list"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "nguspring.painter_maimai_daily"
}
